import React, { useState, useEffect } from 'react';
import { useParams, useNavigate, useLocation } from 'react-router-dom';
import { ArrowLeft, Search, Edit, Trash2, Eye, Plus, X, Save, FileText, Menu } from 'lucide-react';
import axios from 'axios';
import ConfirmationModal from '../components/modals/ConfirmationModal';
import AdminSidebar from '../components/sidebars/AdminSidebar';
import jihLogo from '../assets/LogoColor.png';

const ReportsPage = ({ onLogout }) => {
  const { id } = useParams();
  const navigate = useNavigate();
  const location = useLocation();
  const pathname = location.pathname;

  // Determine current view mode
  const isListView = pathname === '/view-reports';
  const isCreateView = pathname === '/create-report';
  const isViewSingle = pathname.startsWith('/view-report/');
  const isEditView = pathname.startsWith('/edit-report/');

  // Common states
  const [reports, setReports] = useState([]);
  const [report, setReport] = useState(null);
  const [isLoading, setIsLoading] = useState(true);
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [error, setError] = useState('');
  const [success, setSuccess] = useState('');

  // List view states
  const [searchTerm, setSearchTerm] = useState('');
  const [typeFilter, setTypeFilter] = useState('');
  const [reportForFilter, setReportForFilter] = useState('');
  const [statusFilter, setStatusFilter] = useState('');
  const [showDeleteModal, setShowDeleteModal] = useState(false);
  const [showLogoutModal, setShowLogoutModal] = useState(false);
  const [reportToDelete, setReportToDelete] = useState(null);
  // Pagination states
  const [currentPage, setCurrentPage] = useState(1);
  const [totalPages, setTotalPages] = useState(1);
  const [totalCount, setTotalCount] = useState(0);
  const [hasNextPage, setHasNextPage] = useState(false);
  const [hasPrevPage, setHasPrevPage] = useState(false);
  const [isSidebarOpen, setIsSidebarOpen] = useState(false);
  const [adminData, setAdminData] = useState(null);

  // Form states (for create/edit)
  const [reportData, setReportData] = useState({
    type: 'monthly',
    reportFor: 'district',
    title: '',
    description: '',
    isActive: true
  });
  const [parts, setParts] = useState([]);

  // Load admin data on mount
  useEffect(() => {
    const storedAdminData = localStorage.getItem('adminData');
    if (storedAdminData) {
      setAdminData(JSON.parse(storedAdminData));
    }
  }, []);

  // Load reports for list view - reset page when filters change
  useEffect(() => {
    if (isListView) {
      setCurrentPage(1);
    }
  }, [isListView, typeFilter, reportForFilter, statusFilter]);

  // Load reports when page or filters change
  useEffect(() => {
    if (isListView && currentPage > 0) {
      loadReports(currentPage);
    }
  }, [isListView, currentPage, typeFilter, reportForFilter, statusFilter]);

  // Load single report for view/edit
  useEffect(() => {
    if ((isViewSingle || isEditView) && id) {
      loadReport();
    }
  }, [id, isViewSingle, isEditView]);

  // Initialize form for create view
  useEffect(() => {
    if (isCreateView) {
      setReportData({
        type: 'monthly',
        reportFor: 'district',
        title: '',
        description: ''
      });
      setParts([{
        partName: '',
        partOrder: 0,
        questions: [{
          questionText: '',
          questionOrder: 0,
          answerType: 'text',
          options: [],
          isRequired: false,
          placeholder: ''
        }]
      }]);
      setIsLoading(false);
    }
  }, [isCreateView]);

  const loadReports = async (page = 1) => {
    try {
      setIsLoading(true);
      setError('');

      const params = new URLSearchParams();
      if (typeFilter) params.append('type', typeFilter);
      if (reportForFilter) params.append('reportFor', reportForFilter);
      if (statusFilter) params.append('isActive', statusFilter === 'active' ? 'true' : statusFilter === 'inactive' ? 'false' : '');
      params.append('page', page);
      params.append('limit', 10);

      const response = await axios.get(
        `${import.meta.env.VITE_API_URL}/api/admin/reports?${params.toString()}`
      );

      if (response.data.success) {
        const reportsData = response.data.data || [];
        console.log('Loaded reports:', reportsData); // Debug log
        console.log('Sample report reportFor:', reportsData[0]?.reportFor); // Debug log
        
        setReports(reportsData);
        
        // Update pagination state
        setTotalCount(response.data.totalCount || 0);
        setCurrentPage(response.data.currentPage || 1);
        setTotalPages(response.data.totalPages || 1);
        setHasNextPage(response.data.hasNextPage || false);
        setHasPrevPage(response.data.hasPrevPage || false);
      } else {
        setError('Failed to load reports');
      }
    } catch (error) {
      console.error('Error loading reports:', error);
      setError('Failed to load reports. Please try again.');
    } finally {
      setIsLoading(false);
    }
  };

  const loadReport = async () => {
    try {
      setIsLoading(true);
      setError('');

      const token = localStorage.getItem('adminToken');
      const response = await axios.get(
        `${import.meta.env.VITE_API_URL}/api/admin/reports/${id}`,
        {
          headers: {
            Authorization: `Bearer ${token}`
          }
        }
      );

      if (response.data.success) {
        const reportData = response.data.data;
        setReport(reportData);
        
        console.log('Loaded report data:', reportData); // Debug log
        
        if (isEditView) {
          setReportData({
            type: reportData.type || 'monthly',
            reportFor: reportData.reportFor || 'district',
            title: reportData.title || '',
            description: reportData.description || '',
            isActive: reportData.isActive !== undefined ? reportData.isActive : true
          });
          setParts(reportData.parts || []);
          console.log('Set reportData for edit:', {
            type: reportData.type || 'monthly',
            reportFor: reportData.reportFor || 'district',
            title: reportData.title || ''
          }); // Debug log
        }
      } else {
        setError('Failed to load report');
      }
    } catch (error) {
      console.error('Error loading report:', error);
      setError('Failed to load report. Please try again.');
    } finally {
      setIsLoading(false);
    }
  };

  // Delete handlers
  const handleDeleteClick = (report) => {
    setReportToDelete(report);
    setShowDeleteModal(true);
  };

  const handleDeleteConfirm = async () => {
    if (!reportToDelete) return;

    try {
      const token = localStorage.getItem('adminToken');
      const response = await axios.delete(
        `${import.meta.env.VITE_API_URL}/api/admin/reports/${reportToDelete._id}`,
        {
          headers: {
            Authorization: `Bearer ${token}`
          }
        }
      );

      if (response.data.success) {
        setSuccess('Report deleted successfully');
        setShowDeleteModal(false);
        setReportToDelete(null);
        loadReports();
        setTimeout(() => setSuccess(''), 3000);
      } else {
        setError(response.data.message || 'Failed to delete report');
      }
    } catch (error) {
      console.error('Error deleting report:', error);
      setError(
        error.response?.data?.message || 
        'Failed to delete report. Please try again.'
      );
    }
  };

  const handleDeleteCancel = () => {
    setShowDeleteModal(false);
    setReportToDelete(null);
  };

  // Form handlers
  const handleReportDataChange = (field, value) => {
    setReportData(prev => ({
      ...prev,
      [field]: value
    }));
  };

  const handleAddPart = () => {
    setParts(prev => [
      ...prev,
      {
        partName: '',
        partOrder: prev.length,
        questions: [{
          questionText: '',
          questionOrder: 0,
          answerType: 'text',
          options: [],
          isRequired: false,
          placeholder: ''
        }]
      }
    ]);
  };

  const handleRemovePart = (partIndex) => {
    if (parts.length === 1) {
      setError('At least one part is required');
      return;
    }
    setParts(prev => prev.filter((_, index) => index !== partIndex));
  };

  const handlePartNameChange = (partIndex, value) => {
    setParts(prev => prev.map((part, index) => 
      index === partIndex 
        ? { ...part, partName: value }
        : part
    ));
  };

  const handleAddQuestion = (partIndex) => {
    setParts(prev => prev.map((part, index) => {
      if (index === partIndex) {
        return {
          ...part,
          questions: [
            ...part.questions,
            {
              questionText: '',
              questionOrder: part.questions.length,
              answerType: 'text',
              options: [],
              isRequired: false,
              placeholder: ''
            }
          ]
        };
      }
      return part;
    }));
  };

  const handleRemoveQuestion = (partIndex, questionIndex) => {
    setParts(prev => prev.map((part, index) => {
      if (index === partIndex) {
        if (part.questions.length === 1) {
          setError('At least one question is required per part');
          return part;
        }
        return {
          ...part,
          questions: part.questions.filter((_, qIndex) => qIndex !== questionIndex)
        };
      }
      return part;
    }));
  };

  const handleQuestionChange = (partIndex, questionIndex, field, value) => {
    setParts(prev => prev.map((part, pIndex) => {
      if (pIndex === partIndex) {
        return {
          ...part,
          questions: part.questions.map((question, qIndex) => {
            if (qIndex === questionIndex) {
              const updated = { ...question, [field]: value };
              
              if (field === 'answerType' && !['radio', 'dropdown', 'checkbox'].includes(value)) {
                updated.options = [];
              }
              
              if (field === 'answerType' && ['radio', 'dropdown', 'checkbox'].includes(value) && updated.options.length === 0) {
                updated.options = [''];
              }
              
              return updated;
            }
            return question;
          })
        };
      }
      return part;
    }));
  };

  const handleAddOption = (partIndex, questionIndex) => {
    setParts(prev => prev.map((part, pIndex) => {
      if (pIndex === partIndex) {
        return {
          ...part,
          questions: part.questions.map((question, qIndex) => {
            if (qIndex === questionIndex) {
              return {
                ...question,
                options: [...question.options, '']
              };
            }
            return question;
          })
        };
      }
      return part;
    }));
  };

  const handleOptionChange = (partIndex, questionIndex, optionIndex, value) => {
    setParts(prev => prev.map((part, pIndex) => {
      if (pIndex === partIndex) {
        return {
          ...part,
          questions: part.questions.map((question, qIndex) => {
            if (qIndex === questionIndex) {
              return {
                ...question,
                options: question.options.map((opt, oIndex) => 
                  oIndex === optionIndex ? value : opt
                )
              };
            }
            return question;
          })
        };
      }
      return part;
    }));
  };

  const handleRemoveOption = (partIndex, questionIndex, optionIndex) => {
    setParts(prev => prev.map((part, pIndex) => {
      if (pIndex === partIndex) {
        return {
          ...part,
          questions: part.questions.map((question, qIndex) => {
            if (qIndex === questionIndex) {
              if (question.options.length === 1) {
                setError('At least one option is required');
                return question;
              }
              return {
                ...question,
                options: question.options.filter((_, oIndex) => oIndex !== optionIndex)
              };
            }
            return question;
          })
        };
      }
      return part;
    }));
  };

  const validateForm = () => {
    if (!reportData.title.trim()) {
      setError('Report title is required');
      return false;
    }

    if (!reportData.reportFor) {
      setError('Report For field is required');
      return false;
    }

    if (parts.length === 0) {
      setError('At least one part is required');
      return false;
    }

    for (let i = 0; i < parts.length; i++) {
      const part = parts[i];
      if (!part.partName.trim()) {
        setError(`Part ${i + 1} name is required`);
        return false;
      }

      if (part.questions.length === 0) {
        setError(`Part "${part.partName}" must have at least one question`);
        return false;
      }

      for (let j = 0; j < part.questions.length; j++) {
        const question = part.questions[j];
        if (!question.questionText.trim()) {
          setError(`Question ${j + 1} in Part "${part.partName}" must have text`);
          return false;
        }

        if (['radio', 'dropdown', 'checkbox'].includes(question.answerType)) {
          if (!question.options || question.options.length === 0) {
            setError(`Question "${question.questionText}" must have at least one option`);
            return false;
          }
          
          const emptyOptions = question.options.filter(opt => !opt.trim());
          if (emptyOptions.length > 0) {
            setError(`Question "${question.questionText}" has empty options. Please fill or remove them.`);
            return false;
          }
        }
      }
    }

    return true;
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    setError('');
    setSuccess('');

    if (!validateForm()) {
      return;
    }

    setIsSubmitting(true);

    try {
      const token = localStorage.getItem('adminToken');
      
      const cleanedParts = parts.map(part => ({
        ...part,
        questions: part.questions.map(q => ({
          ...q,
          options: ['radio', 'dropdown', 'checkbox'].includes(q.answerType) 
            ? q.options.filter(opt => opt.trim()) 
            : []
        }))
      }));

      // Ensure reportFor is always set
      const reportForValue = reportData.reportFor && ['district', 'area', 'unit'].includes(reportData.reportFor) 
        ? reportData.reportFor 
        : 'district';

      const payload = {
        type: reportData.type,
        reportFor: reportForValue,
        title: reportData.title,
        description: reportData.description || '',
        parts: cleanedParts
      };

      // Add isActive only for edit view
      if (isEditView) {
        payload.isActive = reportData.isActive;
      }

      console.log('Submitting payload:', JSON.stringify(payload, null, 2)); // Debug log
      console.log('reportData.reportFor value:', reportData.reportFor); // Debug log
      console.log('Final payload reportFor value:', payload.reportFor); // Debug log

      const url = isEditView 
        ? `${import.meta.env.VITE_API_URL}/api/admin/reports/${id}`
        : `${import.meta.env.VITE_API_URL}/api/admin/reports`;

      const method = isEditView ? 'put' : 'post';

      const response = await axios[method](url, payload, {
        headers: {
          Authorization: `Bearer ${token}`,
          'Content-Type': 'application/json'
        }
      });

      if (response.data.success) {
        console.log('Response data:', response.data); // Debug log
        console.log('Created/Updated report reportFor:', response.data.data?.reportFor); // Debug log
        setSuccess(isEditView ? 'Report updated successfully!' : 'Report created successfully!');
        setTimeout(() => {
          navigate('/view-reports');
        }, 1500);
      } else {
        setError(response.data.message || `Failed to ${isEditView ? 'update' : 'create'} report`);
      }
    } catch (error) {
      console.error(`Error ${isEditView ? 'updating' : 'creating'} report:`, error);
      setError(
        error.response?.data?.message || 
        error.response?.data?.error || 
        `Failed to ${isEditView ? 'update' : 'create'} report. Please try again.`
      );
    } finally {
      setIsSubmitting(false);
    }
  };

  // Helper functions
  // Client-side search filtering (server-side pagination handles type/reportFor/status)
  const filteredReports = reports.filter(report => {
    if (!searchTerm) return true;
    return (
      report.title?.toLowerCase().includes(searchTerm.toLowerCase()) ||
      report.description?.toLowerCase().includes(searchTerm.toLowerCase()) ||
      report.type?.toLowerCase().includes(searchTerm.toLowerCase())
    );
  });

  const formatDate = (dateString) => {
    if (!dateString) return 'N/A';
    const date = new Date(dateString);
    return date.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric'
    });
  };

  const formatMonthYear = (month, year) => {
    if (!month || !year) return 'N/A';
    const date = new Date(year, month - 1, 1);
    return date.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long'
    });
  };

  const formatScheduleDate = (dateString) => {
    if (!dateString) return 'N/A';
    const date = new Date(dateString);
    return date.toLocaleString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    });
  };

  const answerTypes = [
    { value: 'text', label: 'Text' },
    { value: 'number', label: 'Number' },
    { value: 'textarea', label: 'Text Area' },
    { value: 'date', label: 'Date' },
    { value: 'radio', label: 'Radio Button' },
    { value: 'dropdown', label: 'Dropdown' },
    { value: 'checkbox', label: 'Checkbox' }
  ];

  // Sidebar handlers
  const handleTabChange = (tabId) => {
    if (tabId === 'membership') {
      navigate('/membership', { state: { roleHint: 'admin' } });
      return;
    }
    // Navigate to admin dashboard with the selected tab
    if (tabId === 'yearly' || tabId === 'monthly' || tabId === 'stats') {
      navigate('/admin-dashboard', { 
        state: { activeTab: tabId } 
      });
    }
  };

  const handleNavigateToReports = () => {
    navigate('/view-reports');
  };

  const handleDownloadCSV = async () => {
    try {
      const token = localStorage.getItem('adminToken');
      const response = await axios.get(
        `${import.meta.env.VITE_API_URL}/api/admin/forms/export/csv`,
        {
          headers: {
            Authorization: `Bearer ${token}`
          },
          responseType: 'blob'
        }
      );

      const url = window.URL.createObjectURL(new Blob([response.data]));
      const link = document.createElement('a');
      link.href = url;
      link.setAttribute('download', `forms_${new Date().toISOString().split('T')[0]}.csv`);
      document.body.appendChild(link);
      link.click();
      link.remove();
      setSuccess('CSV file downloaded successfully');
      setTimeout(() => setSuccess(''), 3000);
    } catch (error) {
      console.error('Error downloading CSV:', error);
      setError('Failed to download CSV file');
      setTimeout(() => setError(''), 3000);
    }
  };

  const handleNavigateToNotifications = () => {
    navigate('/notifications');
  };

  const handleLogoutClick = () => setShowLogoutModal(true);

  const confirmLogout = () => {
    if (onLogout) {
      onLogout();
    } else {
      localStorage.removeItem('adminToken');
      localStorage.removeItem('adminData');
    }
    setShowLogoutModal(false);
    navigate('/', { replace: true });
  };

  const cancelLogout = () => setShowLogoutModal(false);

  // Helper function to wrap content with sidebar layout
  const wrapWithSidebar = (content) => {
    return (
      <div className="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-50 flex">
        <AdminSidebar
          activeTab=""
          onTabChange={handleTabChange}
          onNavigateToReports={handleNavigateToReports}
          onNavigateToMembership={() => navigate('/membership', { state: { roleHint: 'admin' } })}
          onDownloadCSV={handleDownloadCSV}
          onNavigateToNotifications={handleNavigateToNotifications}
        onLogout={handleLogoutClick}
          adminEmail={adminData?.email || 'Admin'}
          totalForms={0}
          totalSurveys={0}
          isMobileOpen={isSidebarOpen}
          onMobileToggle={() => setIsSidebarOpen(!isSidebarOpen)}
        />

        <div className="flex-1 lg:ml-72 flex flex-col min-w-0 overflow-hidden">
          <header className="lg:hidden bg-white shadow-sm border-b border-gray-200 sticky top-0 z-30">
            <div className="flex items-center justify-between px-4 py-4">
              <button
                onClick={() => setIsSidebarOpen(!isSidebarOpen)}
                className="text-[#002349] hover:bg-gray-100 rounded-lg p-2 transition-colors"
              >
                <Menu className="w-6 h-6" />
              </button>
              <div className="flex items-center space-x-2">
                <img src={jihLogo} alt="JIH Logo" className="h-8 w-auto" />
                <h1 className="text-lg font-bold text-[#002349]">Reports</h1>
              </div>
              <div className="w-10" />
            </div>
          </header>
          <main className="flex-1 overflow-auto px-4 sm:px-6 lg:px-8 py-6">
            {content}
          </main>
        </div>
      </div>
    );
  };

  // Loading state
  if (isLoading && (isListView || isViewSingle || isEditView)) {
    return wrapWithSidebar(
      <div className="flex items-center justify-center min-h-[60vh]">
        <div className="text-center">
          <div className="inline-block w-8 h-8 border-4 border-[#002349] border-t-transparent rounded-full animate-spin"></div>
          <p className="mt-4 text-gray-600">Loading...</p>
        </div>
      </div>
    );
  }

  // Error state for view single/edit
  if ((isViewSingle || isEditView) && (error || !report)) {
    return wrapWithSidebar(
      <div className="max-w-4xl mx-auto">
        <div className="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 rounded">
          <p>{error || 'Report not found'}</p>
          <button
            onClick={() => navigate('/view-reports')}
            className="mt-4 px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors"
          >
            Back to Reports
          </button>
        </div>
      </div>
    );
  }

  // LIST VIEW
  if (isListView) {
    return wrapWithSidebar(
      <div>
        {/* Header with Title, Filters, Search and Create Button */}
        <div className="mb-6">
          <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-4">
            <h2 className="text-2xl sm:text-4xl font-bold text-[#002349]">റിപ്പോർട്ട് ജനറേഷൻ</h2>
            <button
              onClick={() => navigate('/create-report')}
              className="flex items-center justify-center gap-2 px-4 py-2.5 bg-gradient-to-r from-[#957C3D] to-[#8A6F35] hover:from-[#8A6F35] hover:to-[#957C3D] text-white rounded-xl transition-all duration-500 font-semibold hover:shadow-md transform hover:scale-105 ease-out hover:shadow-[#957C3D]/50 text-sm whitespace-nowrap self-start sm:self-auto"
            >
              <Plus className="w-4 h-4" />
              Create Report
            </button>
          </div>
          <div className="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            <div className="relative">
              <select
                value={typeFilter}
                onChange={(e) => setTypeFilter(e.target.value)}
                className="w-full sm:w-auto pl-4 pr-10 py-2.5 text-sm border border-gray-300 rounded-xl focus:ring-2 focus:ring-[#002349] focus:border-transparent transition-all duration-300 hover:border-[#002349]/50 bg-white shadow-sm appearance-none cursor-pointer min-w-[140px]"
              >
                <option value="">All Types</option>
                <option value="monthly">Monthly</option>
                <option value="special">Special</option>
              </select>
              <div className="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                <svg className="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </div>
            <div className="relative">
              <select
                value={reportForFilter}
                onChange={(e) => setReportForFilter(e.target.value)}
                className="w-full sm:w-auto pl-4 pr-10 py-2.5 text-sm border border-gray-300 rounded-xl focus:ring-2 focus:ring-[#002349] focus:border-transparent transition-all duration-300 hover:border-[#002349]/50 bg-white shadow-sm appearance-none cursor-pointer min-w-[140px]"
              >
                <option value="">All Levels</option>
                <option value="district">District</option>
                <option value="area">Area</option>
                <option value="unit">Unit</option>
              </select>
              <div className="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                <svg className="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </div>
            <div className="relative flex-1 sm:max-w-xs">
              <input
                type="text"
                placeholder="Search reports..."
                value={searchTerm}
                onChange={(e) => setSearchTerm(e.target.value)}
                className="w-full pl-9 pr-3 py-2.5 text-sm border border-gray-300 rounded-xl focus:ring-2 focus:ring-[#002349] focus:border-transparent transition-all duration-300 hover:border-[#002349]/50 bg-white shadow-sm"
              />
              <Search className="absolute left-2.5 top-1/2 transform -translate-y-1/2 h-4 w-4 text-gray-400" />
            </div>
          </div>
        </div>

        {/* Messages */}
        {error && (
          <div className="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded">
            <div className="flex items-center justify-between">
              <p>{error}</p>
              <button onClick={() => setError('')} className="text-red-700 hover:text-red-900">
                <X className="w-5 h-5" />
              </button>
            </div>
          </div>
        )}

        {success && (
          <div className="bg-green-50 border-l-4 border-green-500 text-green-700 p-4 mb-6 rounded">
            <div className="flex items-center justify-between">
              <p>{success}</p>
              <button onClick={() => setSuccess('')} className="text-green-700 hover:text-green-900">
                <X className="w-5 h-5" />
              </button>
            </div>
          </div>
        )}

        {/* Reports Table */}
        <div className="bg-white rounded-2xl shadow-lg border border-gray-200 hover:shadow-xl transition-all duration-300 overflow-hidden w-full">
            {filteredReports.length === 0 ? (
              <div className="p-12 text-center">
                <p className="text-gray-600">No reports found</p>
                <button
                  onClick={() => navigate('/create-report')}
                  className="mt-4 px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
                >
                  Create Your First Report
                </button>
              </div>
            ) : (
          <div className="overflow-x-auto w-full">
            <table className="min-w-full divide-y divide-gray-200 w-full">
              <thead className="bg-gray-50">
                <tr>
                  <th className="px-5 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider rounded-tl-2xl">Title</th>
                  <th className="px-5 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                  <th className="px-5 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Report For</th>
                  <th className="px-5 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Parts</th>
                  <th className="px-5 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Questions</th>
                  <th className="px-5 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                  <th className="px-5 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
                  <th className="px-5 py-4 text-center text-xs font-medium text-gray-500 uppercase tracking-wider rounded-tr-2xl">Actions</th>
                </tr>
              </thead>
              <tbody className="bg-white divide-y divide-gray-200">
                {filteredReports.map((report, index, array) => (
                  <tr 
                    key={report._id} 
                    className={`hover:bg-gradient-to-br hover:from-[#002349]/5 hover:to-[#957C3D]/5 cursor-pointer transition-all duration-300 group border-l-4 border-transparent hover:border-[#002349] ${
                      index === array.length - 1 ? 'rounded-b-2xl' : ''
                    }`}
                    onClick={() => navigate(`/report-submissions/${report._id}`)}
                  >
                    <td className="px-5 py-4 whitespace-nowrap">
                      <div>
                        <div className="text-sm font-bold text-[#002349]">{report.title}</div>
                        {report.description && (
                          <div className="text-xs text-gray-500 truncate max-w-xs mt-1">
                            {report.description}
                          </div>
                        )}
                      </div>
                    </td>
                    <td className="px-5 py-4 whitespace-nowrap">
                      <span className={`px-3 py-1.5 text-xs font-semibold rounded-full ${
                        report.type === 'monthly'
                          ? 'bg-blue-100 text-blue-800'
                          : 'bg-purple-100 text-purple-800'
                      }`}>
                        {report.type}
                      </span>
                    </td>
                    <td className="px-5 py-4 whitespace-nowrap">
                      {(() => {
                        const reportForValue = report.reportFor;
                        return (
                          <span className={`px-3 py-1.5 text-xs font-semibold rounded-full capitalize ${
                            reportForValue === 'district'
                              ? 'bg-indigo-100 text-indigo-800'
                              : reportForValue === 'area'
                              ? 'bg-orange-100 text-orange-800'
                              : reportForValue === 'unit'
                              ? 'bg-teal-100 text-teal-800'
                              : 'bg-gray-100 text-gray-800'
                          }`}>
                            {reportForValue || 'N/A'}
                          </span>
                        );
                      })()}
                    </td>
                    <td className="px-5 py-4 whitespace-nowrap text-sm text-gray-600">
                      {report.partCount || 0}
                    </td>
                    <td className="px-5 py-4 whitespace-nowrap text-sm text-gray-600">
                      {report.questionsCount || 0}
                    </td>
                    <td className="px-5 py-4 whitespace-nowrap">
                      <span className={`px-3 py-1.5 text-xs font-semibold rounded-full ${
                        report.isActive
                          ? 'bg-green-100 text-green-800'
                          : 'bg-red-100 text-red-800'
                      }`}>
                        {report.isActive ? 'Active' : 'Inactive'}
                      </span>
                    </td>
                    <td className="px-5 py-4 whitespace-nowrap text-sm text-gray-600">
                      {formatDate(report.createdAt)}
                    </td>
                    <td className="px-5 py-4 whitespace-nowrap text-center">
                      <div className="flex items-center justify-center gap-2" onClick={(e) => e.stopPropagation()}>
                        <button
                          onClick={() => navigate(`/view-report/${report._id}`)}
                          className="text-[#957C3D] hover:text-white p-2 hover:bg-gradient-to-r hover:from-[#957C3D] hover:to-[#8A6F35] rounded-lg transition-all duration-500 transform hover:scale-110 hover:shadow-md"
                          title="View"
                        >
                          <Eye className="w-4 h-4" />
                        </button>
                        <button
                          onClick={() => navigate(`/edit-report/${report._id}`)}
                          className="text-blue-600 hover:text-white p-2 hover:bg-gradient-to-r hover:from-blue-500 hover:to-blue-600 rounded-lg transition-all duration-500 transform hover:scale-110 hover:shadow-md"
                          title="Edit"
                        >
                          <Edit className="w-4 h-4" />
                        </button>
                        <button
                          onClick={() => handleDeleteClick(report)}
                          className="text-red-600 hover:text-white p-2 hover:bg-gradient-to-r hover:from-red-500 hover:to-red-600 rounded-lg transition-all duration-500 transform hover:scale-110 hover:shadow-md"
                          title="Delete"
                        >
                          <Trash2 className="w-4 h-4" />
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
            )}

          {/* Pagination Controls */}
          {totalPages > 1 && (
            <div className="px-6 py-2 border-t border-gray-200 flex items-center justify-between">
                <div className="text-sm text-gray-600">
                  Showing {((currentPage - 1) * 10) + 1} to {Math.min(currentPage * 10, totalCount)} of {totalCount} reports
                </div>
                <div className="flex items-center gap-2">
                  <button
                    onClick={() => setCurrentPage(prev => Math.max(1, prev - 1))}
                    disabled={!hasPrevPage}
                    className="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
                  >
                    Previous
                  </button>
                  <div className="flex items-center gap-1">
                    {Array.from({ length: Math.min(5, totalPages) }, (_, i) => {
                      let pageNum;
                      if (totalPages <= 5) {
                        pageNum = i + 1;
                      } else if (currentPage <= 3) {
                        pageNum = i + 1;
                      } else if (currentPage >= totalPages - 2) {
                        pageNum = totalPages - 4 + i;
                      } else {
                        pageNum = currentPage - 2 + i;
                      }
                      return (
                        <button
                          key={pageNum}
                          onClick={() => setCurrentPage(pageNum)}
                          className={`px-4 py-2 border rounded-lg transition-colors ${
                            currentPage === pageNum
                              ? 'bg-blue-600 text-white border-blue-600'
                              : 'border-gray-300 hover:bg-gray-50'
                          }`}
                        >
                          {pageNum}
                        </button>
                      );
                    })}
                  </div>
                  <button
                    onClick={() => setCurrentPage(prev => Math.min(totalPages, prev + 1))}
                    disabled={!hasNextPage}
                    className="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
                  >
                    Next
                  </button>
                </div>
              </div>
            )}
          </div>

        <ConfirmationModal
          isOpen={showDeleteModal}
          onClose={handleDeleteCancel}
          onConfirm={handleDeleteConfirm}
          title="Delete Report"
          message={`Are you sure you want to delete the report "${reportToDelete?.title}"? This action cannot be undone.`}
          confirmText="Delete"
          cancelText="Cancel"
          type="danger"
        />
        <ConfirmationModal
          isOpen={showLogoutModal}
          onClose={cancelLogout}
          onConfirm={confirmLogout}
          title="Logout"
          message="Are you sure you want to logout from the admin dashboard?"
          confirmText="Logout"
          cancelText="Cancel"
          type="logout"
        />
      </div>
    );
  }

  // VIEW SINGLE REPORT
  if (isViewSingle && report) {
    return wrapWithSidebar(
      <div className="max-w-6xl mx-auto">
        <div className="mb-6 flex items-center justify-between">
          <h2 className="text-2xl font-bold text-[#002349]">{report.title}</h2>
          <div className="flex items-center gap-3">
            <button
              onClick={() => navigate(`/report-submissions/${id}`)}
              className="flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-purple-600 to-purple-700 hover:from-purple-700 hover:to-purple-800 text-white rounded-xl transition-all duration-500 font-semibold hover:shadow-lg transform hover:scale-105"
            >
              <FileText className="w-4 h-4" />
              View Submissions
            </button>
            <button
              onClick={() => navigate(`/edit-report/${id}`)}
              className="flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-[#957C3D] to-[#8A6F35] hover:from-[#8A6F35] hover:to-[#957C3D] text-white rounded-xl transition-all duration-500 font-semibold hover:shadow-lg transform hover:scale-105"
            >
              <Edit className="w-4 h-4" />
              Edit Report
            </button>
          </div>
        </div>

        <div className="bg-white rounded-2xl shadow-lg border border-gray-200 p-6 mb-6">
          <h2 className="text-xl font-semibold text-[#002349] mb-4">Report Information</h2>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Type</label>
                <span className={`inline-block px-3 py-1 text-sm font-semibold rounded-full ${
                  report.type === 'monthly'
                    ? 'bg-blue-100 text-blue-800'
                    : 'bg-purple-100 text-purple-800'
                }`}>
                  {report.type}
                </span>
              </div>
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Report For</label>
                <span className={`inline-block px-3 py-1 text-sm font-semibold rounded-full capitalize ${
                  report.reportFor === 'district'
                    ? 'bg-indigo-100 text-indigo-800'
                    : report.reportFor === 'area'
                    ? 'bg-orange-100 text-orange-800'
                    : report.reportFor === 'unit'
                    ? 'bg-teal-100 text-teal-800'
                    : 'bg-gray-100 text-gray-800'
                }`}>
                  {report.reportFor || 'N/A'}
                </span>
              </div>
              {report.type === 'monthly' && (
                <>
                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-1">Scheduled For</label>
                    <p className="text-gray-900">{formatScheduleDate(report.scheduledFor)}</p>
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-1">Month / Year</label>
                    <p className="text-gray-900">{formatMonthYear(report.month, report.year)}</p>
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-1">Recurring Template</label>
                    <span className={`inline-block px-3 py-1 text-sm font-semibold rounded-full ${
                      report.recurringMonthly ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'
                    }`}>
                      {report.recurringMonthly ? 'Yes' : 'No'}
                    </span>
                  </div>
                </>
              )}
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Status</label>
                <span className={`inline-block px-3 py-1 text-sm font-semibold rounded-full ${
                  report.isActive
                    ? 'bg-green-100 text-green-800'
                    : 'bg-red-100 text-red-800'
                }`}>
                  {report.isActive ? 'Active' : 'Inactive'}
                </span>
              </div>
              {report.description && (
                <div className="md:col-span-2">
                  <label className="block text-sm font-medium text-gray-700 mb-1">Description</label>
                  <p className="text-gray-900">{report.description}</p>
                </div>
              )}
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Created</label>
                <p className="text-gray-900">
                  {new Date(report.createdAt).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </p>
              </div>
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Parts</label>
                <p className="text-gray-900">{report.parts?.length || 0} part(s)</p>
              </div>
            </div>
          </div>

        <div className="space-y-6">
          {report.parts && report.parts.length > 0 ? (
            report.parts.map((part, partIndex) => (
              <div key={partIndex} className="bg-white rounded-2xl shadow-lg border border-gray-200 p-6">
                  <h3 className="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2">
                    Part {partIndex + 1}: {part.partName}
                  </h3>
                  {part.questions && part.questions.length > 0 ? (
                    <div className="space-y-4">
                      {part.questions.map((question, questionIndex) => (
                        <div key={questionIndex} className="border-l-4 border-blue-500 pl-4 py-2 bg-gray-50 rounded-r">
                          <div className="flex items-center gap-2 mb-2">
                            <span className="text-sm font-medium text-gray-700">Q{questionIndex + 1}:</span>
                            <span className="text-gray-900 font-medium">{question.questionText}</span>
                            {question.isRequired && (
                              <span className="text-xs text-red-600 font-semibold">*Required</span>
                            )}
                          </div>
                          <div className="mt-2 space-y-1">
                            <div className="text-sm text-gray-600">
                              <span className="font-medium">Answer Type:</span>{' '}
                              <span className="capitalize">{question.answerType}</span>
                            </div>
                            {question.options && question.options.length > 0 && (
                              <div className="text-sm text-gray-600">
                                <span className="font-medium">Options:</span>
                                <ul className="list-disc list-inside mt-1 ml-2">
                                  {question.options.map((option, optIndex) => (
                                    <li key={optIndex}>{option}</li>
                                  ))}
                                </ul>
                              </div>
                            )}
                            {question.placeholder && (
                              <div className="text-sm text-gray-600">
                                <span className="font-medium">Placeholder:</span>{' '}
                                <span className="italic">{question.placeholder}</span>
                              </div>
                            )}
                          </div>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <p className="text-gray-500 italic">No questions in this part</p>
                  )}
                </div>
              ))
            ) : (
              <div className="bg-white rounded-2xl shadow-lg border border-gray-200 p-6 text-center">
                <p className="text-gray-500">No parts defined for this report</p>
              </div>
            )}
        </div>

        <ConfirmationModal
          isOpen={showLogoutModal}
          onClose={cancelLogout}
          onConfirm={confirmLogout}
          title="Logout"
          message="Are you sure you want to logout from the admin dashboard?"
          confirmText="Logout"
          cancelText="Cancel"
          type="logout"
        />
      </div>
    );
  }

  // CREATE/EDIT VIEW
  if (isCreateView || isEditView) {
    return wrapWithSidebar(
      <div className="max-w-3xl mx-auto space-y-4">
        <h2 className="text-2xl sm:text-4xl font-bold text-[#002349] mb-6">
          റിപ്പോർട്ട് ജനറേഷൻ
        </h2>

        {error && (
          <div className="bg-red-50 border-l-4 border-red-500 text-red-700 p-3 rounded-xl shadow-sm">
            <p className="text-sm">{error}</p>
          </div>
        )}

        {success && (
          <div className="bg-green-50 border-l-4 border-green-500 text-green-700 p-3 rounded-xl shadow-sm">
            <p className="text-sm">{success}</p>
          </div>
        )}

        <form onSubmit={handleSubmit} className="space-y-4">
          <div className="bg-white/90 backdrop-blur-sm rounded-xl shadow-lg border border-[#002349]/10 p-4">
              <h2 className="text-lg font-semibold text-[#002349] mb-3">Report Information</h2>
              <div className="space-y-3">
                <div>
                  <label className="block text-xs font-medium text-gray-700 mb-1.5">
                    Report Type <span className="text-red-500">*</span>
                  </label>
                  <select
                    value={reportData.type}
                    onChange={(e) => handleReportDataChange('type', e.target.value)}
                    className="w-full px-3 py-1.5 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                    required
                  >
                    <option value="monthly">Monthly</option>
                    <option value="special">Special</option>
                  </select>
                  {reportData.type === 'monthly' && (
                    <p className="mt-2 text-sm text-blue-600">
                      Monthly reports go live immediately for the current month and a fresh copy will auto-generate on the 1st of every month.
                    </p>
                  )}
                </div>
                <div>
                  <label className="block text-xs font-medium text-gray-700 mb-1.5">
                    Report For <span className="text-red-500">*</span>
                  </label>
                  <select
                    value={reportData.reportFor}
                    onChange={(e) => handleReportDataChange('reportFor', e.target.value)}
                    className="w-full px-3 py-1.5 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                    required
                  >
                    <option value="district">District</option>
                    <option value="area">Area</option>
                    <option value="unit">Unit</option>
                  </select>
                </div>
                <div>
                  <label className="block text-xs font-medium text-gray-700 mb-1.5">
                    Report Title <span className="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    value={reportData.title}
                    onChange={(e) => handleReportDataChange('title', e.target.value)}
                    className="w-full px-3 py-1.5 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                    placeholder="Enter report title"
                    required
                  />
                </div>
                <div>
                  <label className="block text-xs font-medium text-gray-700 mb-1.5">Description</label>
                  <textarea
                    value={reportData.description}
                    onChange={(e) => handleReportDataChange('description', e.target.value)}
                    className="w-full px-3 py-1.5 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                    placeholder="Enter report description (optional)"
                    rows="2"
                  />
                </div>
                {isEditView && (
                  <div className="flex items-center gap-2">
                    <input
                      type="checkbox"
                      id="isActive"
                      checked={reportData.isActive}
                      onChange={(e) => handleReportDataChange('isActive', e.target.checked)}
                      className="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
                    />
                    <label htmlFor="isActive" className="text-sm font-medium text-gray-700">
                      Active (Report will be visible to users)
                    </label>
                  </div>
                )}
              </div>
            </div>

          <div className="space-y-4">
            {parts.map((part, partIndex) => (
              <div key={partIndex} className="bg-white rounded-xl shadow-md border border-gray-100 p-4">
                  <div className="flex items-center justify-between mb-3">
                    <h2 className="text-base font-semibold text-[#002349]">Part {partIndex + 1}</h2>
                    <div className="flex gap-2">
                      {parts.length > 1 && (
                        <button
                          type="button"
                          onClick={() => handleRemovePart(partIndex)}
                          className="p-1.5 text-red-600 hover:bg-red-50 rounded-lg transition-colors"
                        >
                          <Trash2 className="w-4 h-4" />
                        </button>
                      )}
                    </div>
                  </div>
                  <div className="mb-4">
                    <label className="block text-sm font-medium text-gray-700 mb-1.5">
                      Part Name <span className="text-red-500">*</span>
                    </label>
                    <input
                      type="text"
                      value={part.partName}
                      onChange={(e) => handlePartNameChange(partIndex, e.target.value)}
                      className="w-full px-3 py-1.5 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                      placeholder="Enter part/section name"
                      required
                    />
                  </div>
                  <div className="space-y-3">
                    <h3 className="text-base font-medium text-gray-700">Questions</h3>
                    {part.questions.map((question, questionIndex) => (
                      <div key={questionIndex} className="border border-gray-200 rounded-lg p-3 bg-gray-50/80">
                        <div className="flex items-center justify-between mb-3">
                          <h4 className="text-sm font-medium text-gray-700">Question {questionIndex + 1}</h4>
                          <div className="flex items-center gap-3">
                            <div className="flex items-center gap-1.5">
                              <input
                                type="checkbox"
                                id={`required-${partIndex}-${questionIndex}`}
                                checked={question.isRequired}
                                onChange={(e) => handleQuestionChange(partIndex, questionIndex, 'isRequired', e.target.checked)}
                                className="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
                              />
                              <label htmlFor={`required-${partIndex}-${questionIndex}`} className="text-xs font-medium text-gray-700">
                                Required
                              </label>
                            </div>
                            {part.questions.length > 1 && (
                              <button
                                type="button"
                                onClick={() => handleRemoveQuestion(partIndex, questionIndex)}
                                className="p-1 text-red-600 hover:bg-red-50 rounded transition-colors"
                              >
                                <X className="w-3.5 h-3.5" />
                              </button>
                            )}
                          </div>
                        </div>
                        <div className="space-y-3">
                          <div>
                            <label className="block text-xs font-medium text-gray-700 mb-1.5">
                              Question Text <span className="text-red-500">*</span>
                            </label>
                            <input
                              type="text"
                              value={question.questionText}
                              onChange={(e) => handleQuestionChange(partIndex, questionIndex, 'questionText', e.target.value)}
                              className="w-full px-3 py-1.5 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                              placeholder="Enter question text"
                              required
                            />
                          </div>
                          <div>
                            <label className="block text-xs font-medium text-gray-700 mb-1.5">
                              Answer Type <span className="text-red-500">*</span>
                            </label>
                            <select
                              value={question.answerType}
                              onChange={(e) => handleQuestionChange(partIndex, questionIndex, 'answerType', e.target.value)}
                              className="w-full px-3 py-1.5 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                              required
                            >
                              {answerTypes.map(type => (
                                <option key={type.value} value={type.value}>
                                  {type.label}
                                </option>
                              ))}
                            </select>
                          </div>
                          {['radio', 'dropdown', 'checkbox'].includes(question.answerType) && (
                            <div>
                              <label className="block text-xs font-medium text-gray-700 mb-1.5">
                                Options <span className="text-red-500">*</span>
                              </label>
                              <div className="space-y-1.5">
                                {question.options.map((option, optionIndex) => (
                                  <div key={optionIndex} className="flex gap-1.5">
                                    <input
                                      type="text"
                                      value={option}
                                      onChange={(e) => handleOptionChange(partIndex, questionIndex, optionIndex, e.target.value)}
                                      className="flex-1 px-3 py-1.5 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                      placeholder={`Option ${optionIndex + 1}`}
                                      required
                                    />
                                    {question.options.length > 1 && (
                                      <button
                                        type="button"
                                        onClick={() => handleRemoveOption(partIndex, questionIndex, optionIndex)}
                                        className="p-1.5 text-red-600 hover:bg-red-50 rounded-lg transition-colors"
                                      >
                                        <X className="w-3.5 h-3.5" />
                                      </button>
                                    )}
                                  </div>
                                ))}
                                <button
                                  type="button"
                                  onClick={() => handleAddOption(partIndex, questionIndex)}
                                  className="flex items-center gap-1.5 px-2 py-1 text-xs text-blue-600 hover:bg-blue-50 rounded-lg transition-colors"
                                >
                                  <Plus className="w-3.5 h-3.5" />
                                  Add Option
                                </button>
                              </div>
                            </div>
                          )}
                          {['text', 'textarea', 'number'].includes(question.answerType) && (
                            <div>
                              <label className="block text-xs font-medium text-gray-700 mb-1.5">
                                Placeholder (Optional)
                              </label>
                              <input
                                type="text"
                                value={question.placeholder}
                                onChange={(e) => handleQuestionChange(partIndex, questionIndex, 'placeholder', e.target.value)}
                                className="w-full px-3 py-1.5 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                placeholder="Enter placeholder text"
                              />
                            </div>
                          )}
                        </div>
                      </div>
                    ))}
                    <button
                      type="button"
                      onClick={() => handleAddQuestion(partIndex)}
                      className="w-full flex items-center justify-center gap-2 px-4 py-2 text-sm bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors font-medium"
                    >
                      <Plus className="w-4 h-4" />
                      Add Question
                    </button>
                  </div>
                </div>
              ))}
              <button
                type="button"
                onClick={handleAddPart}
                className="w-full flex items-center justify-center gap-2 px-4 py-2 text-sm bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors font-medium"
              >
                <Plus className="w-4 h-4" />
                Add Part/Section
              </button>
            </div>

          <div className="flex flex-col sm:flex-row gap-3 justify-end pt-4">
            <button
              type="button"
              onClick={() => navigate('/view-reports')}
              className="px-4 py-2 text-sm bg-gray-100 text-gray-700 rounded-xl hover:bg-gray-200 transition-colors font-medium shadow-sm"
            >
              Cancel
            </button>
            <button
              type="submit"
              disabled={isSubmitting}
              className="px-4 py-2 text-sm bg-gradient-to-r from-[#002349] to-[#1a3a5c] hover:from-[#1a3a5c] hover:to-[#002349] text-white rounded-xl transition-all duration-500 font-semibold disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2 shadow-md hover:shadow-lg"
            >
              {isSubmitting ? (
                <>
                  <div className="w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                  {isEditView ? 'Updating...' : 'Creating...'}
                </>
              ) : (
                <>
                  <Save className="w-5 h-5" />
                  {isEditView ? 'Update Report' : 'Create Report'}
                </>
              )}
            </button>
          </div>
        </form>

        <ConfirmationModal
          isOpen={showLogoutModal}
          onClose={cancelLogout}
          onConfirm={confirmLogout}
          title="Logout"
          message="Are you sure you want to logout from the admin dashboard?"
          confirmText="Logout"
          cancelText="Cancel"
          type="logout"
        />
      </div>
    );
  }

  return null;
};

export default ReportsPage;

